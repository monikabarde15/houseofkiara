{
  "name": "hok-final",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "express": "^5.2.1",
    "framer-motion": "^10.18.0",
    "lucide-react": "^1.7.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.2",
    "swiper": "^12.1.3",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:frontend\" \"npm run dev:admin\" \"npm run dev:proxy\" \"npm run dev:backend\"",
    "dev:frontend": "vite --port=3005 --strictPort --host=0.0.0.0",
    "dev:admin": "npm run dev --prefix hok_admin",
    "dev:proxy": "node dev-proxy.js",
    "dev:backend": "node --watch-path=hok_admin/backend --watch-preserve-output --watch hok_admin/backend/server.js",
    "server": "node --watch-path=hok_admin/backend --watch-preserve-output --watch hok_admin/backend/server.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "http-proxy-middleware": "^2.0.6",
    "vite": "^8.0.3"
  }
}
